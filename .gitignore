# UPSTREAM directory - we want to track this directory but not any temporary files inside
UPSTREAM/
# But track the structure and .git subdirectories to maintain submodules
!UPSTREAM/**
!UPSTREAM/**/.git

# UTCP-KB directory
.utcp-kb/
# Track the directory structure but not temporary processing files and large data files
.utcp-kb/**/*.json
.utcp-kb/**/*.bin
.utcp-kb/**/*.dat
.utcp-kb/**/*.pkl
.utcp-kb/**/embeddings/
.utcp-kb/**/indexes/
